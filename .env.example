# Copy this to .env.local for local dev. Never commit .env.local.
# For Fly deploys, set each of these via `fly secrets set KEY=value`.

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# In dev: http://localhost:3000
# In prod: https://inventory.hikersco.com
NEXTAUTH_URL=http://localhost:3000

# ---- Google OAuth (for sign-in) ----
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of email addresses allowed to sign in.
# Lock this to yourself for now; add others (e.g. bookkeeper) when ready.
ALLOWED_EMAILS=melissa@hikersco.com

# ---- Google Sheets API (service account, for backend reads/writes) ----
# Service account email looks like: hikers-inventory@<project>.iam.gserviceaccount.com
# Share your "ATS - 2026" sheet with this email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Paste the entire private_key value from the service account JSON, INCLUDING
# the BEGIN/END lines. Use real \n newlines (the loader handles either form).
GOOGLE_SERVICE_ACCOUNT_KEY=

# Spreadsheet ID of the live tracker workbook (the "ATS - 2026" sheet)
SHEET_ID=1zZ7lQ2C200TrHsPX-43EDtc0dZzMpj__eG54YOQGSCA
